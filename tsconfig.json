{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["bun-types"],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@db/*": ["./src/db/*"],
      "@media/*": ["./src/media/*"],
      "@player/*": ["./src/player/*"],
      "@bot/*": ["./src/bot/*"],
      "@ws/*": ["./src/ws/*"],
      "@api/*": ["./src/api/*"]
    }
  },
  "include": ["src"]
}
